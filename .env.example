# Server
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Jira connection (server-side only, never exposed to the browser)
JIRA_BASE_URL=https://your-domain.atlassian.net
# basic = Jira Cloud email + API token, bearer = personal access token,
# none = no credentials (put Jira behind a reverse proxy that adds auth)
JIRA_AUTH_MODE=basic
JIRA_EMAIL=name@company.com
JIRA_API_TOKEN=

# Optional defaults. They seed data/settings.json and can be changed in the UI.
JIRA_LABEL=christmas-2026
JIRA_PROJECT_KEY=
JIRA_QUANTITY_FIELD=
JIRA_ISSUE_KEY=
JIRA_POLL_INTERVAL_MS=15000
JIRA_AUTO_REFRESH=true
JIRA_MAX_RESULTS=200
JIRA_ISSUE_TYPE=Task

# Optional status mapping, e.g. {"Peer Review":"In Review","Ready for Deploy":"Release"}
JIRA_STATUS_MAP={}

# Backend tuning
JIRA_TIMEOUT_MS=12000
JIRA_RETRIES=2
JIRA_CACHE_TTL_MS=5000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
