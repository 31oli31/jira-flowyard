{
  "manifest_version": 3,
  "name": "Christmas Logistics Campus",
  "short_name": "Campus",
  "version": "1.0.0",
  "description": "3D Jira campus: tickets travel as parcels across conveyor lanes. Talks directly to the Jira REST API from your browser.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open the Christmas Logistics Campus",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "jira-flowyard@campus.local",
      "strict_min_version": "128.0"
    }
  }
}
